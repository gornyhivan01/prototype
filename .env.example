# Скопируйте в .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Для запуска вне Docker (локально)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app

# JWT: SECRET_KEY в продакшене замените на случайную строку (>= 32 символов):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie-сессия. COOKIE_SECURE=true на HTTPS; SameSite=strict|lax|none.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

DEBUG=false
