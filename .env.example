# Скопируйте в .env. Порт 5433 выбран, чтобы не конфликтовать с другими
# локальными PostgreSQL на 5432.
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5433/app
DEBUG=false

# Секрет для подписи JWT. Для локального запуска подойдёт значение по умолчанию
# из app/config.py, но в продакшене задайте случайную строку (>= 32 символов):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- SSO (Keycloak в docker-compose) ---
# Адрес Keycloak, реалм и клиент создаются автоматически из
# keycloak/realm-export.json при `docker compose up -d keycloak`.
SSO_ENABLED=true
# Только SSO: парольный /auth/login начнёт возвращать 403.
SSO_ONLY=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=prototype
KEYCLOAK_CLIENT_ID=prototype-web
KEYCLOAK_CLIENT_SECRET=prototype-web-secret
SSO_REDIRECT_URI=http://localhost:8000/auth/sso/callback
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/
