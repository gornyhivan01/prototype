# Пример прод-конфига. Скопируйте в .env рядом с docker-compose.prod.yml
# и замените все значения. .env в git не попадает.
#
# Секреты удобно генерировать так:
#   openssl rand -hex 32     # SECRET_KEY, пароли БД, секрет клиента
# Используйте hex/alphanumeric: пароль подставляется в SQL и в URL.

# --- Адреса -------------------------------------------------------------
# Публичный IP VM (без покупки домена используем sslip.io).
PUBLIC_IP=203.0.113.10
APP_HOST=app.203.0.113.10.sslip.io
AUTH_HOST=auth.203.0.113.10.sslip.io
APP_URL=https://app.203.0.113.10.sslip.io
AUTH_URL=https://auth.203.0.113.10.sslip.io

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_hex
POSTGRES_DB=app
# Отдельная БД и роль для Keycloak (создаются при первом старте postgres).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_hex

# --- Приложение ---------------------------------------------------------
APP_IMAGE=prototype-app:latest
DEBUG=false
SECRET_KEY=CHANGE_ME_64_hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- SSO / Keycloak -----------------------------------------------------
SSO_ENABLED=true
# true — парольный /auth/login отключён, вход только через SSO.
SSO_ONLY=false
KEYCLOAK_REALM=prototype
KEYCLOAK_CLIENT_ID=prototype-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_hex
# Master-админ Keycloak (создаётся при первом старте).
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_hex

# Одноразовый первый администратор приложения (роль admin в реалме prototype).
# Нужен только для ./deploy/deploy.sh --bootstrap; после создания админа
# эти две строки можно удалить (иначе повторный --bootstrap сбросит пароль).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_hex

# DATABASE_URL, KEYCLOAK_URL, SSO_REDIRECT_URI и
# SSO_POST_LOGOUT_REDIRECT_URI подставляет docker-compose.prod.yml
# из переменных выше — вручную их задавать не нужно.
